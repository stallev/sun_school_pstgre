{
  "tocHeading": "Содержание",
  "roles": {
    "teacher": {
      "sections": [
        {
          "id": "today-lessons",
          "title": "Сегодня и уроки",
          "steps": [
            {
              "text": "На экране ",
              "link": { "href": "/today", "label": "Сегодня" },
              "textAfter": " видно прогресс проверки домашнего задания и быстрый вход в текущий урок."
            },
            {
              "text": "Список всех уроков, создание и правка — в разделе ",
              "link": { "href": "/lessons", "label": "Все уроки" },
              "textAfter": ". Новый урок можно добавить только при активном учебном году."
            },
            {
              "text": "В закрытом учебном году уроки и отметки для учителя доступны только для просмотра."
            }
          ]
        },
        {
          "id": "homework",
          "title": "Проверка домашнего задания",
          "steps": [
            {
              "text": "Откройте ",
              "link": { "href": "/check", "label": "Проверка ДЗ" },
              "textAfter": " — приложение перенаправит к текущему уроку или подскажет, что проверять нечего."
            },
            {
              "text": "Проходите учеников по очереди, сохраняйте отметки и завершите проверку, когда все ответы внесены."
            },
            {
              "text": "Сводную таблицу по уроку и ведомость открывают с карточки урока — там же можно поправить отметку, если ошиблись."
            }
          ]
        },
        {
          "id": "group",
          "title": "Состав группы",
          "steps": [
            {
              "text": "В ",
              "link": { "href": "/group", "label": "Состав группы" },
              "textAfter": " добавляйте и исключайте учеников, указывайте дату рождения — она нужна для дней рождения в календаре."
            }
          ]
        },
        {
          "id": "bricks",
          "title": "Кирпичики",
          "steps": [
            {
              "text": "На ",
              "link": { "href": "/bricks", "label": "Кирпичики" },
              "textAfter": " выдавайте награды и смотрите журнал. Ошибку исправляют новой записью, старые строки не удаляют."
            }
          ]
        },
        {
          "id": "calendar-rating",
          "title": "Календарь, рейтинг и аналитика",
          "steps": [
            {
              "text": "В ",
              "link": { "href": "/calendar", "label": "Календарь" },
              "textAfter": " — уроки, события и дни рождения учеников вашей группы."
            },
            {
              "text": "Рейтинг группы — на ",
              "link": { "href": "/rating", "label": "Рейтинг" },
              "textAfter": "; подробные графики — в разделе Аналитика с выбором учебного года."
            },
            {
              "text": "Откройте ",
              "link": { "href": "/analytics", "label": "Аналитику" },
              "textAfter": " для графиков по группе и ученикам."
            }
          ]
        },
        {
          "id": "achievements",
          "title": "Достижения группы",
          "requiresFeature": "achievements",
          "steps": [
            {
              "text": "Когда включены достижения, подтверждайте предложения и смотрите баллы группы на ",
              "link": { "href": "/group/points", "label": "баллах группы" },
              "textAfter": " (если раздел доступен)."
            }
          ]
        },
        {
          "id": "verses",
          "title": "Золотые стихи",
          "steps": [
            {
              "text": "Справочник стихов школы — в ",
              "link": { "href": "/verses", "label": "Золотые стихи" },
              "textAfter": "."
            }
          ]
        },
        {
          "id": "profile",
          "title": "Профиль",
          "steps": [
            {
              "text": "В ",
              "link": { "href": "/profile", "label": "Профиле" },
              "textAfter": " меняйте способ входа и при необходимости запросите удаление своей учётной записи."
            }
          ]
        }
      ]
    },
    "admin": {
      "sections": [
        {
          "id": "school-year",
          "title": "Школа и учебный год",
          "steps": [
            {
              "text": "Показатели школы — на ",
              "link": { "href": "/school", "label": "Школа" },
              "textAfter": ". В школе может быть только один активный учебный год."
            },
            {
              "text": "Начало и закрытие года — в ",
              "link": { "href": "/year", "label": "Учебный год" },
              "textAfter": ". После закрытия учитель видит год только для чтения; администратор может править с записью в журнал."
            }
          ]
        },
        {
          "id": "approvals-users",
          "title": "Заявки и пользователи",
          "steps": [
            {
              "text": "Новые пользователи — в ",
              "link": { "href": "/approvals", "label": "Заявки на доступ" },
              "textAfter": ": назначьте роль, группы; при отказе укажите причину."
            },
            {
              "text": "Профили, отключение и объединение дублей — в ",
              "link": { "href": "/users", "label": "Пользователи" },
              "textAfter": "."
            }
          ]
        },
        {
          "id": "pupils",
          "title": "Ученики и группы",
          "steps": [
            {
              "text": "Карточки учеников, бумажное согласие, зачисление и перевод — в ",
              "link": { "href": "/people", "label": "Ученики и семьи" },
              "textAfter": "."
            },
            {
              "text": "Язык группы, назначения учителей и настройки — в ",
              "link": { "href": "/groups", "label": "Группы" },
              "textAfter": "."
            }
          ]
        },
        {
          "id": "families",
          "title": "Семьи",
          "requiresFeature": "parents",
          "steps": [
            {
              "text": "Связь родителей с детьми и согласия — в ",
              "link": { "href": "/family", "label": "Семьи" },
              "textAfter": "."
            }
          ]
        },
        {
          "id": "bricks-admin",
          "title": "Кирпичики",
          "steps": [
            {
              "text": "Выдача и журнал по всем группам — в ",
              "link": { "href": "/bricks", "label": "Кирпичики" },
              "textAfter": " (меню «Люди»)."
            }
          ]
        },
        {
          "id": "achievements-admin",
          "title": "Достижения и штрафы",
          "requiresFeature": "achievements",
          "steps": [
            {
              "text": "Каталог достижений и штрафов — в ",
              "link": { "href": "/achievements", "label": "Достижения и штрафы" },
              "textAfter": "; баллы по группам — на странице каждой группы."
            }
          ]
        },
        {
          "id": "analytics-audit",
          "title": "Аналитика и журнал",
          "steps": [
            {
              "text": "Сводные показатели — в ",
              "link": { "href": "/analytics", "label": "Аналитике" },
              "textAfter": ", рейтинг по группам — в Рейтинге, история правок — в Журнале изменений."
            },
            {
              "text": "Журнал изменений открывается из меню ",
              "link": { "href": "/audit", "label": "Журнал изменений" },
              "textAfter": "."
            }
          ]
        },
        {
          "id": "deletions-settings",
          "title": "Удаление данных и настройки",
          "steps": [
            {
              "text": "Запросы на удаление личных данных — в ",
              "link": { "href": "/deletions", "label": "Запросы на удаление" },
              "textAfter": "."
            },
            {
              "text": "Язык интерфейса для всей школы — в ",
              "link": { "href": "/settings", "label": "Настройки приложения" },
              "textAfter": "."
            }
          ]
        }
      ]
    },
    "parent": {
      "sections": [
        {
          "id": "consent",
          "title": "Согласие на данные ребёнка",
          "steps": [
            {
              "text": "Для каждого ребёнка нужно отдельное электронное согласие — без него экран ",
              "link": { "href": "/child", "label": "Успехи" },
              "textAfter": " не откроется."
            }
          ]
        },
        {
          "id": "progress",
          "title": "Успехи ребёнка",
          "steps": [
            {
              "text": "На ",
              "link": { "href": "/child", "label": "Успехи" },
              "textAfter": " — посещаемость, кирпичики и, если включены, достижения. Голосовой проверки стихов в приложении нет."
            }
          ]
        },
        {
          "id": "achievements-parent",
          "title": "Достижения",
          "requiresFeature": "achievements",
          "steps": [
            {
              "text": "Подтверждённые достижения ребёнка отображаются на том же экране успехов."
            }
          ]
        },
        {
          "id": "calendar-parent",
          "title": "Календарь",
          "steps": [
            {
              "text": "В ",
              "link": { "href": "/calendar", "label": "Календаре" },
              "textAfter": " — только события групп ваших детей, без редактирования и без дней рождения."
            }
          ]
        },
        {
          "id": "contacts",
          "title": "Контакты и удаление",
          "steps": [
            {
              "text": "Свои телефон и email, отзыв согласия и запрос на удаление данных ребёнка — в ",
              "link": { "href": "/child/data", "label": "Данные и согласия" },
              "textAfter": "."
            }
          ]
        }
      ]
    }
  }
}
