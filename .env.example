# Copy to .env (repo root, git-ignored). Names only: never commit values.
# Local setup guide: docs/implementation/mvp/guides/local_dev_setup.md
# Production matrix: docs/implementation/mvp/guides/vercel_deploy_guide.md §4

# --- core ---
# dev | prod — must match the marker stored in the database (INV-24)
APP_ENV=dev
# Neon pooled URL (host contains -pooler) — used by the application at runtime
DATABASE_URL=
# Neon direct (non-pooled) URL — Prisma CLI (migrate, seed) only; NOT set in Vercel runtime
DIRECT_URL=

# --- auth (Auth.js v5, Telegram OIDC + email/password) ---
# openssl rand -base64 32 ; different for dev and prod
AUTH_SECRET=
# Public origin of the app (HTTPS in prod/preview tunnels)
AUTH_URL=http://localhost:3000
# true behind Vercel / reverse proxy (auth_runtime_spec §3)
AUTH_TRUST_HOST=true
AUTH_TELEGRAM_ID=
AUTH_TELEGRAM_SECRET=
# First admin credentials: read ONLY by `npm run db:seed:admin` (dev: .local/dev-secrets.json),
# never by the app and never set in Vercel runtime
FIRST_ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dev teacher credentials: read ONLY by `npm run db:seed:teacher` (dev: .local/dev-secrets.json).
# The command refuses unless APP_ENV and the DB marker are dev. Not set in prod or Vercel runtime.
TEACHER_EMAIL=
TEACHER_PASSWORD=

# --- sentry (optional in dev) ---
# Client bundle — public DSN only (no secrets in NEXT_PUBLIC_* besides this DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (optional if NEXT_PUBLIC_SENTRY_DSN is set)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# 0…1; 1 = every request traced (fine locally). On Vercel prod use ~0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1

# --- lab PageSpeed Insights (local script only, never NEXT_PUBLIC_*) ---
# Enable API: Google Cloud -> PageSpeed Insights API
PAGE_SPEED_API_KEY=
PSI_ORIGIN=
