{
  "name": "sunschool",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/policy/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sunschool/web",
    "build": "npm run build -w @sunschool/web",
    "build:check": "node scripts/check-build-isolation.mjs && npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node -e \"const {spawnSync}=require('child_process'); const r=spawnSync(process.execPath,['node_modules/vitest/vitest.mjs','run','--passWithNoTests'],{stdio:'inherit',env:{...process.env,RUN_DB_INTEGRATION:'1'}}); process.exit(r.status??1)\"",
    "db:generate": "npm run db:generate -w @sunschool/db",
    "db:migrate:dev": "npm run db:migrate:dev -w @sunschool/db",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @sunschool/db",
    "db:migrate:status": "npm run db:migrate:status -w @sunschool/db",
    "db:seed:reference": "npm run seed:reference -w @sunschool/db",
    "db:seed:admin": "npm run seed:admin -w @sunschool/db",
    "db:seed:teacher": "npm run seed:teacher -w @sunschool/db",
    "db:seed:dev": "npm run seed:dev -w @sunschool/db --",
    "db:delete:year": "npm run delete:year -w @sunschool/db --",
    "db:seed:bible": "npm run seed:bible -w @sunschool/db",
    "db:seed:bible:niv": "npm run seed:bible:niv -w @sunschool/db",
    "check:no-niv-in-git": "node scripts/check-no-niv-in-git.mjs",
    "rules:sync": "node scripts/sync-claude-rules.mjs",
    "rules:check": "node scripts/sync-claude-rules.mjs --check",
    "deps:check": "node scripts/check-exact-deps.mjs",
    "encoding:check": "node scripts/check-text-encoding.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "psi:lab": "node scripts/psi-lab/run-pagespeed.mjs",
    "cu:verify": "node scripts/cu-verify.mjs",
    "cu:commit": "node scripts/cu-commit.mjs",
    "phase:run": "node scripts/run-phase.mjs",
    "prepare": "node -e \"try{require('fs').accessSync('.git');require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  }
}
